{
  "name": "claude-pipelines",
  "version": "0.1.0",
  "description": "Deterministic, code-first pipelines for the Claude Agent SDK. Nodes are shell commands, Claude invocations, or plain functions — wired together with await, not a canvas.",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": ["src", "README.md"],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "example:ci": "bun run examples/ci.ts",
    "example:triage": "bun run examples/triage.ts"
  },
  "keywords": ["claude", "claude-code", "agent-sdk", "pipeline", "dag", "workflow", "ci"],
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.245",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/node": "^26.3.0",
    "typescript": "^7.0.2"
  }
}
